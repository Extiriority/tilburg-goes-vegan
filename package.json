{
  "name": "tilburg-goes-vegan",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "prepare": "svelte-kit sync",
    "db:setup:local": "node --experimental-strip-types scripts/setup-local.mjs",
    "privacy:cleanup:local": "node --experimental-strip-types scripts/cleanup-local.mjs",
    "privacy:watch:local": "node --experimental-strip-types scripts/cleanup-local.mjs --watch",
    "operations:run:local": "node --experimental-strip-types scripts/operations-local.mjs",
    "operations:watch:local": "node --experimental-strip-types scripts/operations-local.mjs --watch"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/karla": "^5.3.0",
    "drizzle-orm": "^0.45.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "@sveltejs/adapter-cloudflare": "^7.2.0",
    "@sveltejs/kit": "^2.37.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.0",
    "miniflare": "4.20260730.0",
    "svelte": "^5.38.0",
    "svelte-check": "^4.3.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0",
    "vitest": "5.0.4",
    "wrangler": "^4.151.0"
  },
  "overrides": {
    "cookie": "^0.7.2",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    },
    "tinypool": "^2.1.2",
    "miniflare": {
      "undici": "^7.29.1",
      "sharp": "^0.35.5"
    }
  }
}
